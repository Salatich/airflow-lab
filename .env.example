# ==============================================================================
# Apache Airflow 2.10+ Sandbox Environment Configuration
# ==============================================================================

# Airflow Core & Image Settings
AIRFLOW_IMAGE_NAME=apache/airflow:2.10.5
AIRFLOW_UID=50000
AIRFLOW_GID=0
_PIP_ADDITIONAL_REQUIREMENTS=apache-airflow-providers-amazon>=8.0.0 boto3>=1.35.0 psycopg2-binary>=2.9.9

# Airflow Metadata Database (PostgreSQL 16)
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow
POSTGRES_PORT=5432
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:airflow@postgres:5432/airflow

# Airflow Admin User Credentials
AIRFLOW_WWW_USER_USERNAME=airflow
AIRFLOW_WWW_USER_PASSWORD=airflow
AIRFLOW_WWW_USER_FIRSTNAME=Lead
AIRFLOW_WWW_USER_LASTNAME=Engineer
AIRFLOW_WWW_USER_EMAIL=salatich@users.noreply.github.com
AIRFLOW_WWW_USER_ROLE=Admin

# Airflow Concurrency & Resource Tuning (Operational Benchmarks)
AIRFLOW__CORE__PARALLELISM=32
AIRFLOW__CORE__MAX_ACTIVE_TASKS_PER_DAG=16
AIRFLOW__CORE__MAX_ACTIVE_RUNS_PER_DAG=16
AIRFLOW__CORE__DAG_CONCURRENCY=16
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__LOAD_EXAMPLES=false
AIRFLOW__CORE__DAGS_ARE_PAUSED_AT_CREATION=false
AIRFLOW__API__AUTH_BACKENDS=airflow.api.auth.backend.basic_auth,airflow.api.auth.backend.session

# Security & Secrets
AIRFLOW__CORE__FERNET_KEY=46BKJoQYlPPOexq0OhDZnIlNepKFf87WFwLbfzqnzq8=
AIRFLOW__CORE__ENABLE_XCOM_PICKLING=false

# Custom XCom Backend (Routing large artifacts to MinIO / S3)
AIRFLOW__CORE__XCOM_BACKEND=custom_xcom_backend.MinIOXComBackend
XCOM_S3_BUCKET=airflow-xcom-bucket
XCOM_S3_KEY_PREFIX=xcom/
XCOM_SIZE_THRESHOLD_BYTES=1024

# MinIO (S3-Compatible Object Store)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET_NAME=airflow-xcom-bucket

# AWS / MinIO Connection Config
AWS_CONN_ID=aws_minio
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_ENDPOINT_URL=http://minio:9000
AWS_DEFAULT_REGION=us-east-1
